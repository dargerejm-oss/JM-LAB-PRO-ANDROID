{
  "name": "regard-pur",
  "productName": "Regard Pur",
  "version": "3.3.0",
  "description": "Regard Pur - tri de photos",
  "main": "main.js",
  "author": "JM Dargere",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "vendor": "node tools/vendor.js",
    "dist": "electron-builder --win portable nsis"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.12",
    "@mediapipe/tasks-vision": "0.10.35",
    "exifr": "7.1.3",
    "libheif-js": "1.19.8",
    "@vladmandic/face-api": "1.7.15"
  },
  "build": {
    "appId": "com.jmdargere.regardpur",
    "productName": "Regard Pur",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "RegardPur_${version}_${arch}_${target}.${ext}"
    },
    "portable": {
      "artifactName": "RegardPur.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RegardPur_Installation.exe"
    }
  }
}
