{
  "name": "regard-pur",
  "productName": "Regard Pur",
  "version": "3.8.0",
  "description": "Regard Pur - tri de photos",
  "main": "main.js",
  "author": "JM Dargere",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "vendor": "node tools/vendor.js",
    "dist": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@vladmandic/face-api": "1.7.15",
    "electron": "38.8.6",
    "electron-builder": "26.0.12",
    "exifr": "7.1.3",
    "libheif-js": "1.19.8"
  },
  "build": {
    "appId": "com.jmdargere.regardpur",
    "productName": "Regard Pur",
    "files": [
      "main.js",
      "preload.js",
      "ai.js",
      "ai_child.js",
      "renderer/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/{linux,darwin}/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "RegardPur_${version}_${arch}_${target}.${ext}"
    },
    "portable": {
      "artifactName": "RegardPur.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RegardPur_Installation.exe"
    },
    "extraResources": [
      {
        "from": "modeles",
        "to": "modeles",
        "filter": [
          "*.onnx"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ]
  },
  "dependencies": {
    "onnxruntime-node": "^1.22.0"
  }
}
